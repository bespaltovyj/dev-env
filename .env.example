# ================================================================ .env для compose-win.yaml
# Скопируйте в .env и заполните. .env не попадает в образ (см. .dockerignore).
# Все переменные из .env передаются внутрь контейнера agent.

# ================================================================ запуск (используются compose-win.yaml)
AGENT_IMAGE=localhost/agent-box:latest
AGENT_MEMORY=4g
AGENT_CPUS=2
AGENT_PIDS=1024

# ================================================================ postgres (данные в томе agent-box_postgres)
# Пользователь, пароль и БД применяются только при первом запуске, когда том пуст
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# POSTGRES_PORT=5432                            порт на 127.0.0.1 Windows
# POSTGRES_MEMORY=512m

# ================================================================ резервные копии (сервис backup, README.md «Резервная копия томов»)
# BACKUP_INTERVAL=3600                          проверка изменений и копия, секунды
# BACKUP_KEEP=2                                 сколько последних копий хранить в data/backup

# ================================================================ мониторинг (профиль monitoring, README.md п. 10)
# COMPOSE_PROFILES=monitoring                   поднимать мониторинг без --profile
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# METRICS_RETENTION=30d
# LOGS_RETENTION=14d
# TRACES_RETENTION=7d

# ================================================================ orca serve (scripts/build/entrypoint.sh, порт в compose-win.yaml)
# ORCA_SERVE=0                                  не запускать сервер при старте контейнера
# ORCA_PORT=6769                                порт в контейнере и на 127.0.0.1 Windows (6768 занят десктопным Orca)
# ORCA_PAIRING_ADDRESS=ws://127.0.0.1:6769      адрес, который получит Orca на Windows

# ================================================================ ключи и токены
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ================================================================ Langfuse (трейсинг Claude Code, хук Stop)
# Без TRACE_TO_LANGFUSE=true хук ничего не отправляет. Домен сервера должен быть в allowlist (settings/egress/envoy.yaml)
# TRACE_TO_LANGFUSE=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# CC_LANGFUSE_DEBUG=true                        подробный лог в ~/.claude/state/langfuse_hook.log

# ================================================================ git (scripts/build/entrypoint.sh, README.md п. 6)
# Автор и коммиттер: имя и email как в GitHub (user.name/user.email в ~/.gitconfig ставятся из GIT_AUTHOR_*)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
# GitHub по https (git clone/push): fine-grained токен только на нужные репозитории — Contents, Pull requests.
# Виден всем агентам в окружении контейнера. Без токена — только чтение публичных репозиториев
# GH_TOKEN=github_pat_...
# Подпись коммитов и тегов включена по умолчанию: SSH-ключ контейнера ~/.ssh/git-signing создаётся при первом
# запуске; его .pub добавить в GitHub как Signing key (Settings → SSH and GPG keys), тогда коммиты «Verified»
# GIT_SIGN=0                                    не подписывать
# GIT_SIGNING_KEY=/home/agent/.ssh/git-signing  свой ключ подписи (приватный; рядом должен лежать .pub)

# ================================================================ переопределение настроек образа
# TZ=Europe/Moscow
# JAVA_HOME меняет JDK для Maven и Gradle; `java` из PATH остаётся 25 — для него $JAVA_HOME/bin/java
# JAVA_HOME=/usr/lib/jvm/temurin-21
# GOTOOLCHAIN=auto
# KUBECONFIG=/home/agent/.kube/config

# ================================================================ прокси
# HTTP(S)_PROXY / NO_PROXY задаёт compose-win.yaml (http://egress:3128) — значения отсюда игнорируются.
# Разрешённые домены — политика allowlist в settings/egress/envoy.yaml.
