# ================================================================ .env для compose.yaml
# Скопируйте в .env и заполните. .env не попадает в образ (см. .dockerignore).
# Все переменные из .env передаются внутрь контейнера agent.

# ================================================================ запуск (используются compose.yaml)
AGENT_IMAGE=localhost/agent-box:latest
AGENT_MEMORY=4g
AGENT_CPUS=2
AGENT_PIDS=1024

# ================================================================ postgres (данные в data/postgres)
# Пользователь, пароль и БД применяются только при первом запуске, когда data/postgres пуста
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
# POSTGRES_PORT=5432                            порт на 127.0.0.1 Windows
# POSTGRES_MEMORY=512m

# ================================================================ мониторинг (профиль monitoring, INSTALL.md п. 10)
# COMPOSE_PROFILES=monitoring                   поднимать мониторинг без --profile
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
# METRICS_RETENTION=30d
# LOGS_RETENTION=14d
# TRACES_RETENTION=7d

# ================================================================ orca serve (scripts/build/entrypoint.sh, порт в compose.yaml)
# ORCA_SERVE=0                                  не запускать сервер при старте контейнера
# ORCA_PORT=6769                                порт в контейнере и на 127.0.0.1 Windows (6768 занят десктопным Orca)
# ORCA_PAIRING_ADDRESS=ws://127.0.0.1:6769      адрес, который получит Orca на Windows

# ================================================================ ключи и токены
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GH_TOKEN=

# ================================================================ Langfuse (трейсинг Claude Code, хук Stop)
# Без TRACE_TO_LANGFUSE=true хук ничего не отправляет. Домен сервера должен быть в settings/egress/allowlist.txt
# TRACE_TO_LANGFUSE=true
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# CC_LANGFUSE_DEBUG=true                        подробный лог в ~/.claude/state/langfuse_hook.log

# ================================================================ git
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ================================================================ переопределение настроек образа
# TZ=Europe/Moscow
# JAVA_HOME меняет JDK для Maven и Gradle; `java` из PATH остаётся 25 — для него $JAVA_HOME/bin/java
# JAVA_HOME=/usr/lib/jvm/temurin-21
# GOTOOLCHAIN=auto
# KUBECONFIG=/home/agent/.kube/config

# ================================================================ прокси
# HTTP(S)_PROXY / NO_PROXY задаёт compose.yaml (http://egress:3128) — значения отсюда игнорируются.
# Разрешённые домены: settings/egress/allowlist.txt. Корпоративный прокси — cache_peer в settings/egress/squid.conf.
