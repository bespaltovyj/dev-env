# ================================================================ .env для compose.yaml
# Скопируйте в .env и заполните. .env не попадает в образ (см. .dockerignore).
# Все переменные из .env передаются внутрь контейнера agent.

# ================================================================ запуск (используются compose.yaml)
AGENT_IMAGE=localhost/agent-box:latest
WORKSPACES_DIR=./data/workspaces
AGENT_HOME_DIR=./data/home
AGENT_MEMORY=4g
AGENT_CPUS=2
AGENT_PIDS=1024

# ================================================================ orca serve (entrypoint.sh, порт в compose.yaml)
# ORCA_SERVE=0                                  не запускать сервер при старте контейнера
# ORCA_PORT=6769                                порт в контейнере и на 127.0.0.1 Windows (6768 занят десктопным Orca)
# ORCA_PAIRING_ADDRESS=ws://127.0.0.1:6769      адрес, который получит Orca на Windows

# ================================================================ ключи и токены
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GH_TOKEN=

# ================================================================ git
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=

# ================================================================ переопределение настроек образа
# TZ=Europe/Moscow
# JAVA_HOME меняет JDK для Maven и Gradle; `java` из PATH остаётся 25 — для него $JAVA_HOME/bin/java
# JAVA_HOME=/usr/lib/jvm/temurin-21
# GOTOOLCHAIN=auto
# KUBECONFIG=/home/agent/.kube/config

# ================================================================ прокси
# HTTP(S)_PROXY / NO_PROXY задаёт compose.yaml (http://egress:3128) — значения отсюда игнорируются.
# Разрешённые домены: egress/allowlist.txt. Корпоративный прокси — cache_peer в egress/squid.conf.
