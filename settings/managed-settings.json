{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          { "type": "command", "command": "/usr/local/bin/dcg" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "/opt/langfuse-hook/bin/python /usr/local/lib/agent-box/langfuse_hook.py", "timeout": 30 }
        ]
      }
    ]
  }
}
